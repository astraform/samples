<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath />
    </parent>

    <groupId>ai.astraform.samples</groupId>
    <artifactId>starter-java-spring</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Astraform Domain Provider Starter for Java and Spring</name>
    <description>Minimal Spring Boot starter for Astraform domain providers using remote-domain.v1</description>
    <url>https://github.com/astraform/samples/tree/main/starter-java-spring</url>

    <scm>
        <connection>scm:git:https://github.com/astraform/samples.git</connection>
        <developerConnection>scm:git:https://github.com/astraform/samples.git</developerConnection>
        <url>https://github.com/astraform/samples</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <remote-domain.sdk.version>0.4.5</remote-domain.sdk.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.astraform</groupId>
            <artifactId>sdk-java</artifactId>
            <version>${remote-domain.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.astraform</groupId>
            <artifactId>conformance-java</artifactId>
            <version>${remote-domain.sdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>starter-java-spring</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration>
                    <mainClass>ai.astraform.remote.domain.template.PopulationCatalogPreflight</mainClass>
                    <arguments>
                        <argument>${project.basedir}/src/main/resources/population-catalogs/acme-remote.population-catalog.json</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
