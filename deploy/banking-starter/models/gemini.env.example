# Partner-agent model only. Customer model remains in Astraform private/model.env.
# Values are literal, unquoted single lines. Keep this file private.
BANKING_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
BANKING_LLM_MODEL=gemini-2.5-flash
BANKING_LLM_BINDING_REVISION=banking-starter-gemini25-flash-v1
BANKING_LLM_AUTH_TYPE=bearer
BANKING_LLM_API_KEY=
BANKING_LLM_TIMEOUT_SECONDS=120
BANKING_LLM_MAX_OUTPUT_TOKENS=2048
BANKING_LLM_MAX_CONCURRENCY=1
BANKING_LLM_REASONING_EFFORT=none
