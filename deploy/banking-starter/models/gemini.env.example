# Partner-agent model only. Select gemini-3.6-flash independently in platform private/model.env.
# Values are literal, unquoted single lines. Keep the initialized profile private.
BANKING_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
BANKING_LLM_MODEL=gemini-3.6-flash
BANKING_LLM_BINDING_REVISION=banking-starter-gemini36-high-v2
BANKING_LLM_AUTH_TYPE=bearer
BANKING_LLM_API_KEY=
BANKING_LLM_TIMEOUT_SECONDS=60
BANKING_LLM_MAX_OUTPUT_TOKENS=32768
BANKING_LLM_MAX_CONCURRENCY=1
BANKING_LLM_REASONING_EFFORT=high
BANKING_LLM_TEMPERATURE=1.0
