# Partner only; the complete local Ollama profile enables thinking by default.
# init.py appends the generated inbound token and preserves this profile revision.
CREATIVE_AGENCY_LLM_PROVIDER_ID=ollama
CREATIVE_AGENCY_LLM_BASE_URL=http://host.docker.internal:11434/v1
CREATIVE_AGENCY_LLM_AUTH_TYPE=none
CREATIVE_AGENCY_LLM_API_KEY=
CREATIVE_AGENCY_LLM_MODEL=qwen3.5:4b
CREATIVE_AGENCY_LLM_BINDING_REVISION=marketing-starter-qwen35-4b-thinking-v3
CREATIVE_AGENCY_LLM_ALLOW_INSECURE_HTTP=true
CREATIVE_AGENCY_LLM_TOKEN_LIMIT_PARAMETER=max-tokens
CREATIVE_AGENCY_LLM_REASONING_EFFORT=high
CREATIVE_AGENCY_LLM_TEMPERATURE=1.0
CREATIVE_AGENCY_LLM_TOP_P=0.95
CREATIVE_AGENCY_LLM_MAX_OUTPUT_TOKENS=32768
CREATIVE_AGENCY_LLM_MAX_RESPONSE_BYTES=1048576
CREATIVE_AGENCY_LLM_READ_TIMEOUT=60s
CREATIVE_AGENCY_LLM_MAX_ATTEMPTS=1
CREATIVE_AGENCY_A2A_AGENT_TIMEOUT_SECONDS=70
