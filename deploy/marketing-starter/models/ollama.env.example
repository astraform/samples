# Partner only; uses the existing nonthinking marketing evaluation profile.
# Generated inbound token and binding revision are appended by init.py.
CREATIVE_AGENCY_LLM_PROVIDER_ID=ollama
CREATIVE_AGENCY_LLM_BASE_URL=http://host.docker.internal:11434/v1
CREATIVE_AGENCY_LLM_AUTH_TYPE=none
CREATIVE_AGENCY_LLM_API_KEY=
CREATIVE_AGENCY_LLM_MODEL=qwen3.5:4b
CREATIVE_AGENCY_LLM_ALLOW_INSECURE_HTTP=true
CREATIVE_AGENCY_LLM_TOKEN_LIMIT_PARAMETER=max-tokens
CREATIVE_AGENCY_LLM_REASONING_EFFORT=none
CREATIVE_AGENCY_LLM_MAX_OUTPUT_TOKENS=2048
CREATIVE_AGENCY_LLM_READ_TIMEOUT=90s
CREATIVE_AGENCY_A2A_AGENT_TIMEOUT_SECONDS=110
