# Partner only; select gemini-3.6-flash independently in platform private/model.env.
# init.py appends the generated inbound token and matches the Runtime binding revision.
CREATIVE_AGENCY_LLM_PROVIDER_ID=google-gemini
CREATIVE_AGENCY_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CREATIVE_AGENCY_LLM_AUTH_TYPE=bearer
CREATIVE_AGENCY_LLM_API_KEY=
CREATIVE_AGENCY_LLM_MODEL=gemini-3.6-flash
CREATIVE_AGENCY_LLM_BINDING_REVISION=marketing-starter-gemini36-high-v1
CREATIVE_AGENCY_LLM_TOKEN_LIMIT_PARAMETER=max-completion-tokens
CREATIVE_AGENCY_LLM_REASONING_EFFORT=high
CREATIVE_AGENCY_LLM_MAX_OUTPUT_TOKENS=16384
CREATIVE_AGENCY_LLM_READ_TIMEOUT=120s
CREATIVE_AGENCY_A2A_AGENT_TIMEOUT_SECONDS=300
# Compose fixes model attempts to one and connect timeout remains the adapter's 2s default.
