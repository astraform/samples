# Partner only; customer settings remain in the platform's private/model.env.
# Generated inbound token and binding revision are appended by init.py.
CREATIVE_AGENCY_LLM_PROVIDER_ID=google-gemini
CREATIVE_AGENCY_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CREATIVE_AGENCY_LLM_AUTH_TYPE=bearer
CREATIVE_AGENCY_LLM_API_KEY=
CREATIVE_AGENCY_LLM_MODEL=gemini-2.5-flash
CREATIVE_AGENCY_LLM_TOKEN_LIMIT_PARAMETER=omit
CREATIVE_AGENCY_LLM_MAX_OUTPUT_TOKENS=2048
CREATIVE_AGENCY_LLM_READ_TIMEOUT=120s
CREATIVE_AGENCY_A2A_AGENT_TIMEOUT_SECONDS=140
