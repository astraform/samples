{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astraform:sample:banking-customer-seed.v1.schema.json",
  "title": "Partner-side customer prepopulation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logicalTimeEpochMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799998
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "productCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "balance": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "maxLength": 40
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "limit": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "maxLength": 40
          },
          "currentMinPayment": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "maxLength": 40
          }
        },
        "required": [
          "accountId",
          "name",
          "productCode",
          "balance",
          "currency"
        ]
      }
    },
    "statements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "billId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "accountId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "closingAmount": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "maxLength": 40
          },
          "minimumAmountDue": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "maxLength": 40
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "statementStartDate": {
            "type": "string",
            "format": "date"
          },
          "statementEndDate": {
            "type": "string",
            "format": "date"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "billId",
          "accountId",
          "closingAmount",
          "minimumAmountDue",
          "currency",
          "statementStartDate",
          "statementEndDate",
          "dueDate"
        ]
      }
    }
  },
  "required": [
    "logicalTimeEpochMs",
    "accounts",
    "statements"
  ]
}
